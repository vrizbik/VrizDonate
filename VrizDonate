    @SuppressWarnings("unchecked")
    private List<ItemStack> getKitItems(Rank rank) {
        List<?> list = dataConfig.getList("kits." + rank.id);
        List<ItemStack> result = new ArrayList<>();
        if (list != null) {
            for (Object obj : list) {
                if (obj instanceof ItemStack) {
                    result.add(((ItemStack) obj).clone());
                }
            }
        }
        return result;
    }

