    private ItemStack enchant(ItemStack item, Enchantment ench, int level) {
        ItemMeta meta = item.getItemMeta();
        if (meta != null) {
            meta.addEnchant(ench, level, true);
            item.setItemMeta(meta);
        }
        return item;
    }

    // Определяет ТОЛЬКО ОДИН (высший) ранг игрока для выдачи кита и проверки прав
    private Rank getPlayerHighestRank(Player p) {
        if (p.hasPermission(Rank.SPONSOR.permission)) return Rank.SPONSOR;
        if (p.hasPermission(Rank.DELUX.permission)) return Rank.DELUX;
        if (p.hasPermission(Rank.PREMIUM.permission)) return Rank.PREMIUM;
        if (p.hasPermission(Rank.VIP.permission)) return Rank.VIP;
        return null;
    }

    private boolean hasAtLeast(Player p, Rank required) {
        Rank current = getPlayerHighestRank(p);
        if (current == null) return false;
        return current.ordinal() >= required.ordinal();
    }

