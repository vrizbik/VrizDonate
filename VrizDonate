    private ItemStack createGuiItem(Material mat, String name, List<String> lore) {
        ItemStack item = new ItemStack(mat);
        ItemMeta meta = item.getItemMeta();
        if (meta != null) {
            meta.setDisplayName(name);
            if (lore != null) meta.setLore(lore);
            meta.addItemFlags(ItemFlag.HIDE_ATTRIBUTES, ItemFlag.HIDE_POTION_EFFECTS);
            item.setItemMeta(meta);
        }
        return item;
    }

    private ItemStack createGuiItem(Material mat, String name) {
        return createGuiItem(mat, name, null);
    }

    @EventHandler
    public void onInventoryClick(InventoryClickEvent e) {
        if (!(e.getWhoClicked() instanceof Player)) return;
        Player player = (Player) e.getWhoClicked();

        if (!(e.getInventory().getHolder() instanceof DonateHolder)) return;
        DonateHolder holder = (DonateHolder) e.getInventory().getHolder();

        if ("MAIN".equals(holder.menuType)) {
            e.setCancelled(true);
            int slot = e.getRawSlot();

            if (slot == 22) {
                player.closeInventory();
                player.sendMessage("§8▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬");
                player.sendMessage(" §6§lПОКУПКА ДОНАТА");
                player.sendMessage(" §fНапишите в Telegram: §b§l@vrizbik");
                player.sendMessage("§8▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬");
                player.playSound(player.getLocation(), Sound.ENTITY_EXPERIENCE_ORB_PICKUP, 1f, 1f);
                return;
            }

            Rank clickedRank = Rank.fromSlot(slot);
            if (clickedRank != null) {
                if (e.getClick() == ClickType.RIGHT || e.getClick() == ClickType.SHIFT_RIGHT || e.getClick() == ClickType.LEFT) {
                    openKitPreview(player, clickedRank);
                    player.playSound(player.getLocation(), Sound.BLOCK_SHULKER_BOX_OPEN, 1f, 1f);
                }
            }
        } else if ("PREVIEW".equals(holder.menuType)) {
            e.setCancelled(true);
            if (e.getRawSlot() == 48) {
                openDonateMenu(player);
                player.playSound(player.getLocation(), Sound.UI_BUTTON_CLICK, 1f, 1f);
            } else if (e.getRawSlot() == 49) {
                player.closeInventory();
                player.performCommand("kit");
            }
        } else if ("FURNACE".equals(holder.menuType)) {
            if (e.getRawSlot() < 27 && e.getRawSlot() != 13) {
                e.setCancelled(true);
                if (e.getRawSlot() == 22) {
                    ItemStack input = e.getInventory().getItem(13);
                    if (input == null || input.getType() == Material.AIR) {
                        player.sendMessage("§cПоложите предмет в центральный слот!");
                        return;
                    }
                    ItemStack smelted = getSmeltedResult(input);
                    if (smelted == null) {
                        player.sendMessage("§cЭтот предмет нельзя переплавить!");
                        return;
                    }
                    smelted.setAmount(input.getAmount());
                    e.getInventory().setItem(13, smelted);
                    player.playSound(player.getLocation(), Sound.BLOCK_FURNACE_FIRE_CRACKLE, 1f, 1f);
                    player.sendMessage("§aПредмет успешно переплавлен!");
                }
            }
        }
    }

    private ItemStack getSmeltedResult(ItemStack input) {
        Iterator<Recipe> iter = Bukkit.recipeIterator();
        while (iter.hasNext()) {
            Recipe recipe = iter.next();
            if (recipe instanceof CookingRecipe) {
                CookingRecipe<?> cooking = (CookingRecipe<?>) recipe;
                if (cooking.getInputChoice().test(input)) {
                    return cooking.getResult().clone();
                }
            }
        }
        return null;
    }

    @EventHandler
    public void onPrepareEnchant(PrepareItemEnchantEvent e) {
        if (customEnchantingUsers.contains(e.getEnchanter().getUniqueId())) {
            e.getOffers()[0] = e.getOffers()[0] != null ? e.getOffers()[0] : null;
            // Устанавливаем бонус 15 книжных полок = максимальный 30 уровень зачарования
            try {
                if (e.getOffers()[2] != null) {
                    e.getOffers()[2].setCost(30);
                }
            } catch (Exception ignored) {
            }
        }
    }

    @EventHandler
    public void onInventoryClose(InventoryCloseEvent e) {
        customEnchantingUsers.remove(e.getPlayer().getUniqueId());
        if (e.getInventory().getHolder() instanceof DonateHolder) {
            DonateHolder holder = (DonateHolder) e.getInventory().getHolder();
            if ("FURNACE".equals(holder.menuType)) {
                ItemStack left = e.getInventory().getItem(13);
                if (left != null && left.getType() != Material.AIR) {
                    e.getPlayer().getInventory().addItem(left);
                }
            }
        }
    }

    @Override
    public boolean onCommand(CommandSender sender, Command command, String label, String[] args) {
        if (!(sender instanceof Player)) {
            sender.sendMessage("Команда доступна только игрокам!");
            return true;
        }
        Player p = (Player) sender;
        String cmd = command.getName().toLowerCase();

        switch (cmd) {
            case "donate":
                openDonateMenu(p);
                return true;

            case "setdonatekit":
                if (!p.hasPermission("vrizdonate.admin") && !p.isOp()) {
                    p.sendMessage("§cНет прав!");
                    return true;
                }
                if (args.length < 1) {
                    p.sendMessage("§eИспользование: /setdonatekit <vip|premium|delux|sponsor>");
                    return true;
                }
                Rank targetRank = Rank.fromId(args[0]);
                if (targetRank == null) {
                    p.sendMessage("§cНеверный донат! Доступны: vip, premium, delux, sponsor");
                    return true;
                }
                List<ItemStack> newKit = new ArrayList<>();
                for (ItemStack item : p.getInventory().getStorageContents()) {
                    if (item != null && item.getType() != Material.AIR) {
                        newKit.add(item.clone());
                    }
                }
                for (ItemStack armor : p.getInventory().getArmorContents()) {
                    if (armor != null && armor.getType() != Material.AIR) {
                        newKit.add(armor.clone());
                    }
                }
                dataConfig.set("kits." + targetRank.id, newKit);
                saveData();
                p.sendMessage("§aКит для привилегии " + targetRank.displayName + " §aуспешно сохранён из вашего инвентаря!");
                return true;

            case "kit":
                Rank ownRank = getPlayerHighestRank(p);
                if (ownRank == null) {
                    p.sendMessage("§cУ вас нет привилегии! Купить донат: §e/donate §f(ТГ: §b@vrizbik§f)");
                    return true;
                }
                long lastClaim = dataConfig.getLong("cooldowns." + p.getUniqueId(), 0L);
                long now = System.currentTimeMillis();
                if (now - lastClaim < WEEK_MILLIS && !p.hasPermission("vrizdonate.admin")) {
                    long remaining = (WEEK_MILLIS - (now - lastClaim)) / 1000;
                    long days = remaining / 86400;
                    long hours = (remaining % 86400) / 3600;
                    long minutes = (remaining % 3600) / 60;
                    p.sendMessage("§cВы уже получали свой кит! Следующий будет доступен через: §e"
                            + days + " дн. " + hours + " ч. " + minutes + " мин.");
                    return true;
                }

                List<ItemStack> kitItems = getKitItems(ownRank);
                for (ItemStack item : kitItems) {
                    HashMap<Integer, ItemStack> left = p.getInventory().addItem(item.clone());
                    for (ItemStack drop : left.values()) {
                        p.getWorld().dropItemNaturally(p.getLocation(), drop);
                    }
                }
                dataConfig.set("cooldowns." + p.getUniqueId(), now);
                saveData();
                p.sendMessage("§aВы успешно получили свой еженедельный кит " + ownRank.displayName + "§a!");
                p.playSound(p.getLocation(), Sound.ITEM_ARMOR_EQUIP_DIAMOND, 1f, 1f);
                return true;

            // --- VIP команды (и для всех донатов выше) ---
            case "wb":
                if (!hasAtLeast(p, Rank.VIP)) {
                    sendNoPerm(p, Rank.VIP);
                    return true;
                }
                p.openWorkbench(null, true);
                return true;

            case "grindstone":
                if (!hasAtLeast(p, Rank.VIP)) {
                    sendNoPerm(p, Rank.VIP);
                    return true;
                }
                p.openInventory(Bukkit.createInventory(p, InventoryType.GRINDSTONE, "§8Виртуальное точило"));
                return true;

            // --- PREMIUM команды (и для DELUX, SPONSOR) ---
            case "anvil":
                if (!hasAtLeast(p, Rank.PREMIUM)) {
                    sendNoPerm(p, Rank.PREMIUM);
                    return true;
                }
                p.openInventory(Bukkit.createInventory(p, InventoryType.ANVIL, "§8Виртуальная наковальня"));
                return true;

            case "feed":
                if (!hasAtLeast(p, Rank.PREMIUM)) {
                    sendNoPerm(p, Rank.PREMIUM);
                    return true;
                }
                p.setFoodLevel(20);
                p.setSaturation(20f);
                p.sendMessage("§aВаш голод полностью утолён!");
                return true;

            // --- DELUX команды (и для SPONSOR) ---
            case "smithingtable":
                if (!hasAtLeast(p, Rank.DELUX)) {
                    sendNoPerm(p, Rank.DELUX);
                    return true;
                }
                p.openInventory(Bukkit.createInventory(p, InventoryType.SMITHING, "§8Стол кузнеца"));
                return true;

            case "heal":
                if (!hasAtLeast(p, Rank.DELUX)) {
                    sendNoPerm(p, Rank.DELUX);
                    return true;
                }
                p.setHealth(p.getMaxHealth());
                p.setFoodLevel(20);
                p.setFireTicks(0);
                p.sendMessage("§aВы полностью исцелены!");
                return true;

            // --- SPONSOR команды ---
            case "enchanttable":
                if (!hasAtLeast(p, Rank.SPONSOR)) {
                    sendNoPerm(p, Rank.SPONSOR);
                    return true;
                }
                customEnchantingUsers.add(p.getUniqueId());
                p.openEnchanting(null, true);
                p.sendMessage("§6Открыт стол зачарований §e(Максимальный 30 уровень)§6!");
                return true;

            case "furnace":
                if (!hasAtLeast(p, Rank.SPONSOR)) {
                    sendNoPerm(p, Rank.SPONSOR);
                    return true;
                }
                openVirtualFurnace(p);
                return true;
        }
        return false;
    }

    private void sendNoPerm(Player p, Rank needed) {
        p.sendMessage("§cЭта команда доступна от привилегии " + needed.displayName + " §cи выше! Купить: §e/donate §7(ТГ: @vrizbik)");
    }
}
