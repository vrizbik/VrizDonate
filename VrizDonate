    @Override
    public void onEnable() {
        createDataFile();
        setupDefaultKits();
        Bukkit.getPluginManager().registerEvents(this, this);

        String[] commands = {"donate", "kit", "setdonatekit", "wb", "grindstone", "anvil", "feed", "smithingtable", "heal", "enchanttable", "furnace"};
        for (String cmd : commands) {
            if (getCommand(cmd) != null) {
                getCommand(cmd).setExecutor(this);
            }
        }
        getLogger().info("VrizDonate успешно запущен! Телеграм: @vrizbik");
    }

    private void createDataFile() {
        if (!getDataFolder().exists()) {
            getDataFolder().mkdirs();
        }
        dataFile = new File(getDataFolder(), "data.yml");
        if (!dataFile.exists()) {
            try {
                dataFile.createNewFile();
            } catch (IOException e) {
                e.printStackTrace();
            }
        }
        dataConfig = YamlConfiguration.loadConfiguration(dataFile);
    }

    private void saveData() {
        try {
            dataConfig.save(dataFile);
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    private void setupDefaultKits() {
        boolean changed = false;
        for (Rank rank : Rank.values()) {
            if (!dataConfig.contains("kits." + rank.id)) {
                List<ItemStack> defaultItems = createDefaultKit(rank);
                dataConfig.set("kits." + rank.id, defaultItems);
                changed = true;
            }
        }
        if (changed) saveData();
    }

